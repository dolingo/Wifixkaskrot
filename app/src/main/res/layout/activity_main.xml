<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SentinelNet"
            android:textColor="#58A6FF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network Security Tester"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target subnet or host (e.g. 192.168.1)"
            android:textColor="#C9D1D9"
            android:textColorHint="#484F58"
            android:backgroundTint="#30363D"
            android:inputType="text"
            android:autofillHints="" />

        <EditText
            android:id="@+id/etPorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ports: top100 | all | 80,443 | 1-1024"
            android:textColor="#C9D1D9"
            android:textColorHint="#484F58"
            android:backgroundTint="#30363D"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:autofillHints="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnDiscover"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Discover" />

            <Button
                android:id="@+id/btnPortScan"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Ports" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVulnScan"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Vulns" />

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Capture" />
        </LinearLayout>

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export HTML Report" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log"
            android:textColor="#58A6FF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#C9D1D9"
            android:textSize="12sp"
            android:background="#161B22"
            android:padding="10dp"
            android:minLines="12"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
